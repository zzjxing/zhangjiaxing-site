---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const notes = (await getCollection('notes')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const base = import.meta.env.BASE_URL;
const withBase = (path: string) =>
	base === '/'
		? path
		: `${base.replace(/\/$/, '')}${path === '/' ? '/' : path}`;
---

<BaseLayout title="Notes · zjx" description="Notes by zjx">
	<h1 class="section-title">笔记</h1>
	{
		notes.length === 0 ? (
			<p class="meta">还没有笔记，稍后补充。</p>
		) : (
			<ul class="list">
				{notes.map((note) => (
					<li>
						<a href={withBase(`/notes/${note.id}/`)}>
							<span class="list-title">{note.data.title}</span>
							<span class="list-summary">
								{note.data.date.toISOString().slice(0, 10)}
								{note.data.summary ? ` · ${note.data.summary}` : ''}
							</span>
						</a>
					</li>
				))}
			</ul>
		)
	}
</BaseLayout>

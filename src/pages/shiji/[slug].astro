---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
	const chapters = (await getCollection('shiji')).sort((a, b) => a.data.order - b.data.order);
	return chapters.map((chapter, index) => ({
		params: { slug: chapter.id },
		props: {
			chapter,
			prev: index > 0 ? chapters[index - 1] : null,
			next: index < chapters.length - 1 ? chapters[index + 1] : null,
		},
	}));
}

const { chapter, prev, next } = Astro.props;
const { Content, headings } = await render(chapter);
---

<BaseLayout title={chapter.data.title} description={chapter.data.summary ?? chapter.data.title}>
	<article data-pagefind-body>
		<header class="page-head section article-head">
			<p class="eyebrow">
				<a href={withBase('/shiji/')}>史记</a>
				{' · '}
				第 {chapter.data.order} 篇
			</p>
			<h1>{chapter.data.title}</h1>
			{chapter.data.summary ? <p class="lead">{chapter.data.summary}</p> : null}
		</header>

		<div class="section article-layout">
			<aside class="article-toc" aria-label="目录">
				<p class="eyebrow">目录</p>
				<nav>
					{
						headings
							.filter((heading) => heading.depth === 2)
							.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)
					}
				</nav>
			</aside>
			<div class="prose">
				<Content />
			</div>
		</div>
	</article>

	<nav class="section post-nav-section" aria-label="章节导航">
		<div class="post-nav">
			{
				prev ? (
					<a rel="prev" href={withBase(`/shiji/${prev.id}/`)}>
						<span class="post-nav-label">上一篇</span>
						<span class="post-nav-title">{prev.data.title}</span>
					</a>
				) : (
					<a href={withBase('/shiji/')}>
						<span class="post-nav-label">目录</span>
						<span class="post-nav-title">史记白话讲</span>
					</a>
				)
			}
			{
				next ? (
					<a rel="next" class="post-nav-next" href={withBase(`/shiji/${next.id}/`)}>
						<span class="post-nav-label">下一篇</span>
						<span class="post-nav-title">{next.data.title}</span>
					</a>
				) : (
					<a class="post-nav-next" href={withBase('/shiji/')}>
						<span class="post-nav-label">目录</span>
						<span class="post-nav-title">史记白话讲</span>
					</a>
				)
			}
		</div>
	</nav>
</BaseLayout>

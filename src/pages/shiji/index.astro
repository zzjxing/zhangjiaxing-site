---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const chapters = (await getCollection('shiji')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;
const withBase = (path: string) =>
	base === '/'
		? path
		: `${base.replace(/\/$/, '')}${path === '/' ? '/' : path}`;
---

<BaseLayout title="史记白话讲 · zjx" description="按《史记》篇目顺序的白话详讲">
	<h1 class="section-title">史记白话讲</h1>
	<ul class="list">
		{
			chapters.map((chapter) => (
				<li>
					<a href={withBase(`/shiji/${chapter.id}/`)}>
						<span class="list-title">
							{String(chapter.data.order).padStart(2, '0')} {chapter.data.title}
						</span>
						{chapter.data.summary ? <span class="list-summary">{chapter.data.summary}</span> : null}
					</a>
				</li>
			))
		}
	</ul>
</BaseLayout>

---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import GlassPanel from '@/components/common/GlassPanel.astro';
import { withBase } from '@/lib/url';

export const getStaticPaths = (async () => {
	const chapters = (await getCollection('shiji')).sort((a, b) => a.data.order - b.data.order);
	return chapters.map((chapter, index) => ({
		params: { slug: chapter.id },
		props: {
			chapter,
			prev: index > 0 ? chapters[index - 1] : null,
			next: index < chapters.length - 1 ? chapters[index + 1] : null,
		},
	}));
}) satisfies GetStaticPaths;

const { chapter, prev, next } = Astro.props;
const { Content } = await render(chapter);
---

<BaseLayout title={chapter.data.title} description={chapter.data.summary}>
	<Header />
	<main id="main" tabindex="-1" class="main-content">
		<article class="chapter">
			<div class="container">
				<GlassPanel variant="solid" padding="xl" className="chapter-header">
					<a href={withBase('/shiji/')} class="chapter-back">← 目录</a>
					<p class="chapter-meta">第 {chapter.data.order} 篇</p>
					<h1 class="chapter-title">{chapter.data.title}</h1>
					<nav class="chapter-nav" aria-label="章节导航">
						{
							prev ? (
								<a href={withBase(`/shiji/${prev.id}/`)}>← {prev.data.title}</a>
							) : (
								<span />
							)
						}
						{
							next ? (
								<a href={withBase(`/shiji/${next.id}/`)}>{next.data.title} →</a>
							) : (
								<span />
							)
						}
					</nav>
				</GlassPanel>

				<div class="chapter-body prose">
					<Content />
				</div>

				<nav class="chapter-nav chapter-nav--bottom" aria-label="章节导航">
					{
						prev ? (
							<a href={withBase(`/shiji/${prev.id}/`)}>← {prev.data.title}</a>
						) : (
							<a href={withBase('/shiji/')}>← 目录</a>
						)
					}
					{
						next ? (
							<a href={withBase(`/shiji/${next.id}/`)}>{next.data.title} →</a>
						) : (
							<a href={withBase('/shiji/')}>目录 →</a>
						)
					}
				</nav>
			</div>
		</article>
	</main>
	<Footer />
</BaseLayout>

<style>
	.main-content {
		padding: 3rem 0 5rem;
	}

	.container {
		width: min(760px, calc(100% - 2rem));
		margin: 0 auto;
	}

	.chapter-header {
		margin-bottom: 1.5rem;
	}

	.chapter-back {
		display: inline-block;
		margin-bottom: 1rem;
		text-decoration: none;
		opacity: 0.75;
	}

	.chapter-meta {
		margin: 0 0 0.5rem;
		opacity: 0.65;
		letter-spacing: 0.06em;
	}

	.chapter-title {
		margin: 0 0 1.25rem;
		font-size: clamp(2rem, 5vw, 2.8rem);
		line-height: 1.15;
	}

	.chapter-nav {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.chapter-nav a {
		text-decoration: none;
	}

	.chapter-nav--bottom {
		margin-top: 2.5rem;
		padding: 1rem 1.1rem;
		border-radius: 1rem;
		background: color-mix(in srgb, var(--color-surface, #fff) 70%, transparent);
		border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
	}

	.chapter-body {
		font-size: 1.08rem;
		line-height: 1.9;
	}

	.chapter-body :global(h2) {
		margin-top: 2rem;
	}
</style>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Container from '@/components/ui/Container.astro';
import GlassPanel from '@/components/common/GlassPanel.astro';
---

<BaseLayout title="关于">
	<Header />
	<main id="main" tabindex="-1" class="main-content">
		<Container size="md">
			<GlassPanel variant="solid" padding="xl">
				<h1>关于</h1>
				<p>zjx</p>
			</GlassPanel>
		</Container>
	</main>
	<Footer />
</BaseLayout>

<style>
	.main-content {
		padding: 4rem 0 5rem;
	}

	h1 {
		margin: 0 0 1rem;
	}

	p {
		margin: 0;
		opacity: 0.85;
	}
</style>

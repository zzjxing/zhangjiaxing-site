---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) =>
	base === '/'
		? path
		: `${base.replace(/\/$/, '')}${path === '/' ? '/' : path}`;
---

<BaseLayout title="zjx">
	<section class="hero">
		<h1 class="hero-name">zjx</h1>
		<p class="hero-lead">
			在这里放项目、笔记，以及按《史记》顺序推进的白话详讲。手机也能读，章节可前后跳转。
		</p>
		<div class="hero-actions">
			<a class="button" href={withBase('/shiji/')}>读史记白话讲</a>
			<a class="button secondary" href={withBase('/projects/')}>看项目</a>
		</div>
	</section>

	<section>
		<h2 class="section-title">栏目</h2>
		<p class="section-lead">从书房式首页进入，不必翻仪表盘。</p>
		<div class="card-grid">
			<a class="card" href={withBase('/shiji/')}>
				<h3>史记白话讲</h3>
				<p>按篇目详讲，非常见字带拼音，支持上一篇 / 下一篇。</p>
			</a>
			<a class="card" href={withBase('/notes/')}>
				<h3>笔记</h3>
				<p>随手记下的阅读与想法。</p>
			</a>
			<a class="card" href={withBase('/projects/')}>
				<h3>项目</h3>
				<p>正在做或做过的东西。</p>
			</a>
			<a class="card" href={withBase('/about/')}>
				<h3>关于</h3>
				<p>简短自我介绍。</p>
			</a>
		</div>
	</section>
</BaseLayout>

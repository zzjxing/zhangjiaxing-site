---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import { withBase } from '../lib/url';
import { SITE } from '../consts';

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE.title,
	description: SITE.description,
	url: new URL(withBase('/'), site).href,
};
---

<BaseLayout description={SITE.description}>
	<StructuredData slot="head" schema={websiteSchema} />
	<section class="hero section">
		<h1>zjx</h1>
		<div class="action-row" aria-label="入口">
			<a class="button" href={withBase('/shiji/')}>史记</a>
			<a class="text-link" href={withBase('/works/')}>项目</a>
			<a class="text-link" href={withBase('/blog/')}>笔记</a>
		</div>
	</section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) =>
	base === '/'
		? path
		: `${base.replace(/\/$/, '')}${path === '/' ? '/' : path}`;
---

<BaseLayout title="zjx">
	<section class="hero">
		<h1 class="hero-name">zjx</h1>
		<div class="hero-actions">
			<a class="button" href={withBase('/shiji/')}>史记</a>
			<a class="button secondary" href={withBase('/projects/')}>项目</a>
			<a class="button secondary" href={withBase('/notes/')}>笔记</a>
		</div>
	</section>
</BaseLayout>
